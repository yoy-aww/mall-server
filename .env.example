# 图片 CDN 配置
# 七牛云已于 2026-09 下线，CDN 切换至 jsDelivr: https://cdn.jsdelivr.net/gh/yoy-aww/mall-images/imgs/
# 图片 URL 迁移逻辑在 src/index.js 的 migrateImageUrls() 中（启动时自动执行，幂等）
# 无需设置任何环境变量

# ---- RAG 智能客服（本地商品库检索 + LLM 生成）----
# 浮窗 /api/rag/ask 不再依赖独立 RAG 服务，而是：
#   1) 在本地 SQLite 商品表做关键词检索
#   2) 把 top-N 商品作为上下文喂给 OpenAI 兼容 LLM，生成回答
# 因此只需配置 LLM（sensenova / 任意 OpenAI 兼容 chat/completions）：

# LLM 完整 chat/completions 端点（含 /v1/chat/completions 路径）
LLM_API_BASE=https://token.sensenova.cn/v1/chat/completions

# LLM API key（Bearer 认证）。必填——不填时浮窗降级为纯检索（仍返回商品，但回答是兜底文案）
LLM_API_KEY=sk-your-key-here

# 模型名
LLM_MODEL=sensenova-6.8-flash-lite

# 兼容旧 RAG 服务地址（rag-admin 管理代理仍读这个；如彻底不用可留空，默认 localhost:8000）
# RAG_BASE_URL=http://localhost:8000
# RAG_API_KEY=
# RAG_ADMIN_KEY=
